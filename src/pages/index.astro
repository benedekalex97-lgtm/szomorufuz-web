---
import { inline } from '@/lib/inline';
import FaqSection from '@/components/home/FaqSection.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import IntroSection from '@/components/home/IntroSection.astro';
import LeafMark from '@/components/brand/LeafMark.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import OfficeList from '@/components/sections/OfficeList.astro';
import ServicePaths from '@/components/sections/ServicePaths.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { articleBySlug } from '@/content/articles';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getHomepage, getOffices } from '@/lib/content';

const [home, offices] = await Promise.all([getHomepage(), getOffices()]);
const faqBlock = articleBySlug('gyakori-kerdesek')?.blocks.find((b) => b.type === 'faq');
const faqItems = faqBlock && faqBlock.type === 'faq' ? faqBlock.items.slice(0, 6) : [];
---

<BaseLayout seo={home.seo} reveal>
  <HeroSection hero={home.hero} />

  <Section
    id="teendok"
    eyebrow={home.situations.eyebrow}
    title={home.situations.title}
    intro={home.situations.intro}
    tone="alt"
    layout="split"
  >
    <Fragment slot="header-extra">
      <p class="link-row">
        <a href={home.situations.cta.href}>{home.situations.cta.label}</a>
      </p>
    </Fragment>
    <ul class="situations" role="list">
      {home.situations.items.map((s) => (
        <li>
          <a href={s.href} class="situation">
            <span class="situation__title">{s.title}</span>
            <span class="situation__body">{s.body}</span>
            <Icon name="arrow-right" size={18} class="situation__icon" />
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section
    id="szolgaltatasok"
    eyebrow={home.services.eyebrow}
    title={home.services.title}
    intro={home.services.intro}
  >
    <ServicePaths
      featured={home.services.featured}
      others={home.services.others}
      othersTitle="További szolgáltatásaink"
    />
  </Section>

  <Section
    id="ugyintezes"
    eyebrow={home.handled.eyebrow}
    title={home.handled.title}
    intro={home.handled.intro}
    tone="ink"
  >
    <ul class="handled" role="list">
      {home.handled.items.map((item) => (
        <li>
          <LeafMark size={14} />
          <span>{item}</span>
        </li>
      ))}
    </ul>
    {home.handled.note && <p class="handled__note" set:html={inline(home.handled.note)} />}
  </Section>

  <Section
    id="arak"
    eyebrow={home.prices.eyebrow}
    title={home.prices.title}
    intro={home.prices.intro}
    tone="paper"
  >
    <ul class="prices" role="list">
      {home.prices.items.map((p) => (
        <li>
          <a href={p.href} class="price">
            <span class="price__label">{p.label}</span>
            <span class:list={['price__value', p.quote && 'price__value--quote']}>{p.value}</span>
            <span class="price__note">{p.note}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="link-row">
      <a href={home.prices.cta.href}>{home.prices.cta.label}</a>
      <a href="/arajanlat-keres-itt/">Díjmentes árajánlat kérése</a>
    </p>
  </Section>

  <IntroSection data={home.intro} />

  <Section
    id="irodak"
    eyebrow={home.offices.eyebrow}
    title={home.offices.title}
    intro={home.offices.intro}
    tone="alt"
  >
    <OfficeList offices={offices} />
    <p class="link-row">
      <a href={home.offices.cta.href}>{home.offices.cta.label}</a>
    </p>
  </Section>

  <FaqSection data={home.faq} items={faqItems} />

  <CtaBand title={home.contact.title} intro={home.contact.intro} />
</BaseLayout>

<style>
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin-top: var(--space-6);
  }
  .link-row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-medium);
  }
  .situations {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-text);
  }
  .situation {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid rgb(184 170 152 / 0.8);
    color: var(--color-text);
    text-decoration: none;
  }
  .situation__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 350;
  }
  .situation__body {
    grid-column: 1;
    color: var(--color-text-muted);
  }
  .situation :global(.situation__icon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--color-accent-decor);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .situation:hover .situation__title {
    color: var(--color-accent-text);
  }
  .situation:hover :global(.situation__icon) {
    transform: translateX(4px);
  }
  .handled {
    display: grid;
    gap: 0 var(--space-10);
    padding: 0;
    list-style: none;
  }
  .handled li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-ink-line);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-ink-text);
  }
  .handled :global(.leaf) {
    color: var(--color-ink-accent);
  }
  .prices {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .price {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-6);
    border-top: 1px solid var(--color-text);
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-standard);
  }
  .price:hover {
    background-color: var(--palette-white);
  }
  .handled__note {
    margin-top: var(--space-8);
    max-width: 46rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .handled__note :global(a) {
    color: var(--color-ink-text);
  }
  .price__value--quote {
    font-size: var(--text-2xl);
  }
  .price__label {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .price__value {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 350;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
  }
  .price__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (min-width: 48em) {
    .handled {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .prices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
