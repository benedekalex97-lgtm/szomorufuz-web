---
import AboutSection from '@/components/home/AboutSection.astro';
import FaqSection from '@/components/home/FaqSection.astro';
import HeroSection from '@/components/home/HeroSection.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import OfficeList from '@/components/sections/OfficeList.astro';
import ServicePaths from '@/components/sections/ServicePaths.astro';
import StepList from '@/components/sections/StepList.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaqItems, getHomepage, getOffices } from '@/lib/content';

const [home, offices, faq] = await Promise.all([getHomepage(), getOffices(), getFaqItems()]);
---

<BaseLayout seo={home.seo}>
  <HeroSection hero={home.hero} />

  <Section
    id="teendok"
    eyebrow={home.firstSteps.eyebrow}
    title={home.firstSteps.title}
    intro={home.firstSteps.intro}
    tone="alt"
    layout="split"
  >
    <Fragment slot="header-extra">
      <p class="link-row">
        <a href={home.firstSteps.cta.href}>{home.firstSteps.cta.label}</a>
      </p>
    </Fragment>
    <StepList steps={home.firstSteps.steps} />
  </Section>

  <Section
    id="szolgaltatasok"
    eyebrow={home.services.eyebrow}
    title={home.services.title}
    intro={home.services.intro}
  >
    <ServicePaths featured={home.services.featured} others={home.services.others} />
  </Section>

  <Section
    id="folyamat"
    eyebrow={home.process.eyebrow}
    title={home.process.title}
    intro={home.process.intro}
    tone="ink"
  >
    <StepList steps={home.process.stages} variant="timeline" tone="ink" />
  </Section>

  <Section
    id="arak"
    eyebrow={home.pricing.eyebrow}
    title={home.pricing.title}
    tone="paper"
    layout="split"
  >
    <div class="pricing">
      <p class="pricing__body">{home.pricing.body}</p>
      <Button
        href={home.pricing.cta.href}
        variant="secondary"
        icon="arrow-right"
        iconPosition="end"
      >
        {home.pricing.cta.label}
      </Button>
    </div>
  </Section>

  <AboutSection data={home.about} />

  <Section
    id="irodak"
    eyebrow={home.offices.eyebrow}
    title={home.offices.title}
    intro={home.offices.intro}
    tone="alt"
  >
    <OfficeList offices={offices} />
    <p class="link-row">
      <a href={home.offices.cta.href}>{home.offices.cta.label}</a>
    </p>
  </Section>

  <FaqSection data={home.faq} items={faq} />

  <CtaBand title={home.contact.title} intro={home.contact.intro} />
</BaseLayout>

<style>
  .link-row {
    margin-top: var(--space-6);
  }
  .link-row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-medium);
  }
  .pricing > * + * {
    margin-top: var(--space-8);
  }
  .pricing__body {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 300;
    line-height: 1.35;
    max-width: 32ch;
  }
</style>
