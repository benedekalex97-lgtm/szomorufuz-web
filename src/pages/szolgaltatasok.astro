---
import CtaBand from '@/components/sections/CtaBand.astro';
import ArticleIndex from '@/components/sections/ArticleIndex.astro';
import PageHero from '@/components/sections/PageHero.astro';
import HelpPanel from '@/components/sections/HelpPanel.astro';
import Section from '@/components/ui/Section.astro';
import { articleBySlug } from '@/content/articles';
import type { Article } from '@/content/types';
import BaseLayout from '@/layouts/BaseLayout.astro';

const pick = (slugs: string[]) =>
  slugs.map((s) => articleBySlug(s)).filter((a): a is Article => Boolean(a));
const temetes = pick(['hamvasztasos-temetes', 'koporsos-temetes', 'hamvasztas-urnakiadas']);
const hamvak = pick([
  'hamvak-hazavitele',
  'hamvak-temetese',
  'hamvak-szorasa-temeto',
  'hamvak-szorasa-dunaba',
]);
const bucsu = pick(['ravatalozo-terem', 'polgari-bucsuztatas', 'urnak', 'fiumei-uti-temeto']);
const crumbs = [
  { label: 'Főoldal', href: '/' },
  { label: 'Szolgáltatások', href: '/szolgaltatasok/' },
];
---

<BaseLayout
  seo={{
    title: 'Temetkezési szolgáltatások Budapesten',
    description:
      'Hamvasztásos és koporsós temetés, hamvak hazavitele, szórása és hajós temetés, ravatalozó terem, polgári búcsúztatás, díszurnák – teljes körű ügyintézéssel.',
  }}
>
  <PageHero
    eyebrow="Szolgáltatások"
    title="Temetkezési"
    titleEmphasis="szolgáltatásaink"
    lead="Hamvasztásos és koporsós temetés teljes körű ügyintézéssel – a hamvak elhelyezésének minden formájával, saját ravatalozó teremmel és polgári búcsúztatással."
    breadcrumbs={crumbs}
    seed={17}
  >
    <HelpPanel slot="aside" />
  </PageHero>

  <Section id="temetes" eyebrow="Temetés" title="Hamvasztásos és koporsós temetés">
    <ArticleIndex items={temetes} />
  </Section>
  <Section id="hamvak" eyebrow="Hamvak elhelyezése" title="Hová kerülhetnek a hamvak?" tone="alt">
    <ArticleIndex items={hamvak} />
  </Section>
  <Section
    id="bucsuztatas"
    eyebrow="Búcsúztatás"
    title="Ravatalozás, búcsúztatás, kegyeleti kellékek"
  >
    <ArticleIndex items={bucsu} />
  </Section>

  <CtaBand />
</BaseLayout>
