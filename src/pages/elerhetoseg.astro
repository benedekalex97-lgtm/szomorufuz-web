---
import Form from '@/components/forms/Form.astro';
import LeafList from '@/components/sections/LeafList.astro';
import OfficeList from '@/components/sections/OfficeList.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import Section from '@/components/ui/Section.astro';
import { central, izabellaParking, izabellaTransit, officeHours } from '@/content/data/contact';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getOffices } from '@/lib/content';
import { telHref } from '@/lib/format';

const offices = await getOffices();
const crumbs = [
  { label: 'Főoldal', href: '/' },
  { label: 'Kapcsolat', href: '/elerhetoseg/' },
];
const lines = [central.info, central.transport, central.office];
---

<BaseLayout
  seo={{
    title: 'Elérhetőség – irodáink Budapesten',
    description:
      'Információ: +36 30 847 1915 (6–22 óra), ügyeleti halottszállítás: +36 30 849 3538. Öt budapesti iroda: VI., XII., XIV., XVII., XX. kerület. Ügyfélfogadás H–P 8–16.',
  }}
>
  <PageHero
    eyebrow="Kapcsolat"
    title="Elérhetőség"
    titleEmphasis="és irodáink"
    lead="Hívjon minket bizalommal, vagy keresse fel valamelyik budapesti irodánkat. Ügyfélfogadás hétfőtől péntekig 8:00–16:00 óra között."
    breadcrumbs={crumbs}
    seed={29}
  />

  <Section id="kozponti" eyebrow="Központi telefonszámok" title="Hívjon minket" layout="split">
    <dl class="central">
      {lines.map((line) => (
        <div>
          <dt>{line.label}</dt>
          <dd>
            <a href={telHref(line.phone.e164)}>{line.phone.display}</a>
            {line.note && <span>{line.note}</span>}
          </dd>
        </div>
      ))}
      <div>
        <dt>E-mail</dt>
        <dd>
          <a href={`mailto:${central.email}`} class="central__email">
            {central.email}
          </a>
        </dd>
      </div>
      <div>
        <dt>Ügyfélfogadás irodáinkban</dt>
        <dd class="central__hours">
          {officeHours.map((h) => (
            <span>
              {h.days}: <strong>{h.hours}</strong>
            </span>
          ))}
        </dd>
      </div>
    </dl>
  </Section>

  <Section
    id="irodak"
    eyebrow="Irodáink"
    title="Öt budapesti iroda"
    intro="Minden irodánk saját vezetékes és mobil telefonszámon is elérhető."
    tone="alt"
  >
    <nav class="office-jump" aria-label="Ugrás irodára">
      <ul role="list">
        {offices.map((o) => (
          <li>
            <a href={`#${o.slug}`}>
              {o.name} <span>({o.numeral} ker.)</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <OfficeList offices={offices} detailed />
  </Section>

  <Section
    id="megkozelites"
    eyebrow="Belvárosi iroda"
    title="Megközelítés"
    intro="1064 Budapest, Izabella utca 65. – közel az Oktogonhoz, az Izabella és Aradi utca sarkától 50 méterre, a Podmaniczky utca irányában."
    layout="split"
  >
    <p class="sub">Tömegközlekedéssel</p>
    <LeafList items={izabellaTransit} />
    <p class="sub">Személygépkocsival</p>
    <p class="parking">{izabellaParking}</p>
  </Section>

  <Section
    id="uzenet"
    eyebrow="Írjon nekünk"
    title="Üzenet küldése"
    intro="Kérdését vagy kérését az alábbi űrlapon is elküldheti; munkatársunk a megadott elérhetőségen válaszol. Sürgős esetben kérjük, hívjon minket."
    layout="split"
  >
    <Form form="kapcsolat" headingLevel={3} title="Kapcsolatfelvételi űrlap" />
  </Section>

  <CtaBand
    id="arajanlat-cta"
    title="Kérjen díjmentes árajánlatot"
    intro="Telefonon vagy e-mailben, akár 2 órán belül – hamvasztásos vagy koporsós temetésre."
  />
</BaseLayout>

<style>
  .central > div {
    padding-block: var(--space-5);
    border-bottom: 1px solid rgb(184 170 152 / 0.8);
  }
  .central > div:first-child {
    border-top: 1px solid var(--color-text);
  }
  .central dt {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .central dd > a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 350;
    color: var(--color-text);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .central dd > a.central__email {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    text-decoration: underline;
  }
  .central dd > a:hover {
    color: var(--color-accent-text);
  }
  .central dd > span {
    display: block;
    color: var(--color-text-muted);
  }
  .central__hours span {
    display: block;
    padding-top: var(--space-1);
    font-size: var(--text-lg);
  }
  .sub {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .sub:first-child {
    margin-top: 0;
  }
  .parking {
    color: var(--color-text-muted);
  }
  .office-jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-6);
    padding: 0;
    list-style: none;
  }
  .office-jump a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .office-jump a:hover {
    border-color: var(--color-text);
  }
  .office-jump span {
    margin-inline-start: var(--space-1);
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
  }
</style>
