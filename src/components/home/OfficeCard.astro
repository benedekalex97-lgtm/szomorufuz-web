---
import Icon from '@/components/ui/Icon.astro';
import PendingBadge from '@/components/ui/PendingBadge.astro';
import type { Office } from '@/content/types';
import { publishable } from '@/lib/facts';
import { formatAddress, formatHours, telHref } from '@/lib/format';

interface Props {
  office: Office;
}
const { office } = Astro.props;
const address = publishable(office.address);
const phones = publishable(office.phones);
const hours = publishable(office.openingHours);
const mapUrl = publishable(office.mapUrl);
const hasDetails = address || phones || hours;
---

<article class="office">
  <h3 class="office__name">{office.name}</h3>

  {hasDetails ? (
    <dl class="office__details">
      {address && (
        <div class="office__row">
          <dt>
            <Icon name="map-pin" size={18} />
            <span class="visually-hidden">Cím</span>
          </dt>
          <dd>
            {formatAddress(address.value)}
            {address.pending && <PendingBadge />}
          </dd>
        </div>
      )}
      {phones && (
        <div class="office__row">
          <dt>
            <Icon name="phone" size={18} />
            <span class="visually-hidden">Telefon</span>
          </dt>
          <dd>
            <ul class="office__phones" role="list">
              {phones.value.map((p) => (
                <li>
                  {phones.pending ? (
                    <span>{p.display}</span>
                  ) : (
                    <a href={telHref(p.e164)}>
                      {p.display}
                      <span class="visually-hidden"> – {office.name}</span>
                    </a>
                  )}
                </li>
              ))}
            </ul>
            {phones.pending && <PendingBadge />}
          </dd>
        </div>
      )}
      {hours && (
        <div class="office__row">
          <dt>
            <Icon name="clock" size={18} />
            <span class="visually-hidden">Nyitvatartás</span>
          </dt>
          <dd>
            {hours.value.map((r) => (
              <span class="office__hours">{formatHours(r)}</span>
            ))}
            {hours.pending && <PendingBadge />}
          </dd>
        </div>
      )}
    </dl>
  ) : (
    <p class="office__pending">Cím, telefonszám és nyitvatartás ellenőrzés után jelenik meg.</p>
  )}

  {mapUrl && (
    <p class="office__map">
      <a href={mapUrl.value} target="_blank" rel="noopener noreferrer">
        Útvonaltervezés
        <span class="visually-hidden"> – {office.name}, Google Térkép, új lapon nyílik</span>
        <Icon name="external-link" size={16} />
      </a>
      {mapUrl.pending && <PendingBadge />}
    </p>
  )}
</article>

<style>
  .office {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }
  .office__name {
    font-size: var(--text-lg);
  }
  .office__details {
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .office__row {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: var(--space-2);
    align-items: start;
  }
  .office__row dt {
    padding-top: 0.15rem;
    color: var(--color-accent-text);
  }
  .office__phones {
    padding: 0;
    list-style: none;
    font-variant-numeric: tabular-nums;
  }
  .office__phones a {
    display: inline-block;
    padding-block: var(--space-1);
  }
  .office__hours {
    display: block;
  }
  .office__pending {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .office__map {
    margin-top: auto;
    font-size: var(--text-sm);
  }
  .office__map a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    font-weight: var(--weight-semibold);
  }
</style>
