---
import Button from '@/components/ui/Button.astro';
import PendingBadge from '@/components/ui/PendingBadge.astro';
import PendingNotice from '@/components/ui/PendingNotice.astro';
import PhoneLink from '@/components/ui/PhoneLink.astro';
import type { Homepage } from '@/content/types';
import { getSiteSettings } from '@/lib/content';
import { publishable } from '@/lib/facts';

interface Props {
  data: Homepage['contact'];
}
const { data } = Astro.props;
const settings = await getSiteSettings();
const phone = publishable(settings.primaryPhone);
const availability = publishable(settings.phoneAvailability);
const email = publishable(settings.company.email);
---

<section id="kapcsolat" class="contact" aria-labelledby="kapcsolat-cim">
  <div class="container contact__inner">
    <div class="contact__intro">
      <p class="eyebrow contact__eyebrow">Segítség</p>
      <h2 id="kapcsolat-cim" class="contact__title">
        {data.title}
      </h2>
      <p class="contact__lead">{data.intro}</p>
    </div>

    <div class="contact__panel">
      {phone ? (
        <div class="contact__block">
          <h3 class="contact__label">Telefonos segítség</h3>
          <PhoneLink phone={settings.primaryPhone} class="contact__phone" />
          {availability && (
            <p class="contact__meta">
              {availability.value}
              {availability.pending && <PendingBadge />}
            </p>
          )}
        </div>
      ) : (
        <PendingNotice title="A telefonszám ellenőrzés alatt">
          <p>
            Az élő oldalon egymásnak ellentmondó telefonszámok szerepelnek. A kiemelt, hívható szám
            a Szomorúfűz írásos megerősítése után jelenik meg itt.
          </p>
        </PendingNotice>
      )}

      {email && (
        <div class="contact__block">
          <h3 class="contact__label">E-mail</h3>
          <p>
            {email.pending ? (
              <>
                {email.value}
                <PendingBadge />
              </>
            ) : (
              <a href={`mailto:${email.value}`}>{email.value}</a>
            )}
          </p>
        </div>
      )}

      <div class="contact__block">
        <h3 class="contact__label">Személyesen</h3>
        <Button href="/irodak/" variant="secondary" icon="map-pin">
          Irodáink
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-space);
    background-color: var(--color-bg);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .contact__inner {
    display: grid;
    gap: var(--space-10);
  }
  .contact__intro > * + * {
    margin-top: var(--space-3);
  }
  .contact__title {
    font-size: var(--text-3xl);
  }
  .contact__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 40ch;
  }
  .contact__panel {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }
  .contact__block + .contact__block {
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border-subtle);
  }
  .contact__label {
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  :global(.contact__phone) {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
  }
  .contact__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (min-width: 64em) {
    .contact__inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: var(--space-16);
    }
    .contact__panel {
      padding: var(--space-8);
    }
  }
</style>
