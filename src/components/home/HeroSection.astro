---
import WillowCanopy from '@/components/brand/WillowCanopy.astro';
import { canopySrc } from '@/lib/canopy';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Homepage } from '@/content/types';
import { central } from '@/content/data/contact';
import { telHref } from '@/lib/format';

interface Props {
  hero: Homepage['hero'];
}
const { hero } = Astro.props;

// Asztali korona: két önálló SVG-réteg, csak ≥ 64em-en töltődik le (mobilon 0 bájt).
const layerSrc = (layer: 'back' | 'front') => canopySrc(`hero-${layer}`);
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAAAAACw=';
---

<section class="hero" aria-labelledby="hero-cim">
  <WillowCanopy class="hero__valance" variant="valance" seed={7} />
  <div class="container container--wide hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-cim" class="hero__title">
        <span class="hero__line">
          <span class="hero__line-in">{hero.title}</span>
        </span>
        <span class="hero__line hero__em">
          <span class="hero__line-in">{hero.titleEmphasis}</span>
        </span>
      </h1>
      <p class="hero__lead">{hero.lead}</p>

      <div class="hero__actions">
        <Button href={telHref(central.info.phone.e164)} icon="phone" size="lg">
          Hívás: {central.info.phone.display}
        </Button>
        <Button
          href={hero.secondaryCta.href}
          variant="secondary"
          size="lg"
          icon="arrow-right"
          iconPosition="end"
        >
          {hero.secondaryCta.label}
        </Button>
      </div>

      <dl class="hero__lines">
        {[central.info, central.transport, central.office].map((line) => (
          <div>
            <dt>{line.label}</dt>
            <dd>
              <a href={telHref(line.phone.e164)}>{line.phone.display}</a>
              {line.note && <span>{line.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__canopy" aria-hidden="true">
      {(['back', 'front'] as const).map((layer) => (
        <picture class={`hero__layer hero__layer--${layer}`}>
          <source media="(min-width: 64em)" srcset={layerSrc(layer)} />
          <img src={BLANK} alt="" width="720" height="880" decoding="async" fetchpriority="low" />
        </picture>
      ))}
    </div>
  </div>

  <nav class="container container--wide hero__paths" aria-labelledby="hero-utak">
    <h2 id="hero-utak" class="visually-hidden">
      Miben segíthetünk?
    </h2>
    <ul class="paths" role="list">
      {hero.paths.map((path) => (
        <li>
          <a class="hpath" href={path.href}>
            <span class="hpath__label">{path.label}</span>
            <span class="hpath__title">{path.title}</span>
            <span class="hpath__body">{path.body}</span>
            <Icon name="arrow-right" size={20} class="hpath__icon" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: var(--space-10);
  }
  .hero__inner {
    position: relative;
    display: grid;
  }
  .hero__content {
    position: relative;
    z-index: 1;
  }
  .hero__content > * + * {
    margin-top: var(--space-6);
  }
  .hero__title {
    font-size: var(--text-display);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  /* Soronkénti maszk: a sor a saját dobozából emelkedik fel. A belső térköz a
     lelógó betűszárakat (g, p) védi a vágástól. */
  .hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .hero__line-in {
    display: block;
  }
  .hero__em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent-text);
  }
  .hero__lead {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 30rem;
  }
  .hero__actions {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }
  .hero__lines {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(184 170 152 / 0.7);
    max-width: 40rem;
  }
  .hero__lines dt {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .hero__lines dd a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .hero__lines dd a:hover {
    color: var(--color-accent-text);
  }
  .hero__lines dd span {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (min-width: 40em) {
    .hero__lines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Egy vonalba kerüljenek a számok akkor is, ha a címke két sorba törik */
    .hero__lines dt {
      min-height: 2.9em;
    }
  }

  /* ---------- Lombkorona ----------
     Mobil és tablet: keskeny, teljes szélességű „lombfüggöny” a cím fölött – a cím a fa
     alatt áll, a motívum teljes erővel látszik, és nem takar szöveget.
     Asztali nézet: a korona jobb felülről borul a jobb hasáb fölé (lásd lent). */
  .hero :global(.hero__valance) {
    display: block;
    width: 100%;
    aspect-ratio: 420 / 180;
    max-height: 13rem;
    overflow: clip;
    /* a levélcsúcsok halványan a felirat fölé érnek – a cím a fa alatt áll */
    margin-top: calc(-1 * var(--space-10));
    margin-bottom: calc(-1 * var(--space-6));
    pointer-events: none;
  }
  .hero__canopy {
    display: none;
  }

  .hero__paths {
    position: relative;
    margin-top: var(--space-12);
  }
  .paths {
    position: relative;
    display: grid;
    padding: 0;
    list-style: none;
  }
  /* A szekciókat összekötő vonal – a hero végén felrajzolódik */
  .paths::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background-color: var(--color-text);
    transform-origin: left center;
  }
  .hpath {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid rgb(184 170 152 / 0.8);
    color: var(--color-text);
    text-decoration: none;
  }
  .hpath__label {
    grid-column: 1;
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .hpath__title {
    grid-column: 1;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.2;
    transition: color var(--duration-base) ease;
  }
  .hpath__body {
    grid-column: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .hpath :global(.hpath__icon) {
    grid-column: 2;
    grid-row: 1 / span 3;
    color: var(--color-accent-decor);
    transition: transform var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hpath:hover .hpath__title {
      color: var(--color-accent-text);
    }
    .hpath:hover :global(.hpath__icon) {
      transform: translateX(4px);
    }
  }

  @media (min-width: 40em) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 48em) {
    /* Tablet: keskenyebb, jobbra igazított lombfüggöny – a levelek nem nagyítódnak durvára */
    .hero :global(.hero__valance) {
      width: min(32rem, 66%);
      margin-left: auto;
      margin-bottom: calc(-1 * var(--space-10));
    }
    .paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .hpath {
      height: 100%;
      padding: var(--space-6) var(--space-6) var(--space-8) 0;
      border-bottom: 0;
      align-items: start;
    }
    .paths li + li .hpath {
      padding-inline-start: var(--space-6);
      border-left: 1px solid rgb(184 170 152 / 0.8);
    }
  }

  /* Asztali nézet: a korona a jobb hasáb fölé borul, a viewport széléig fut ki,
     és lent a szolgáltatás-sáv vonaláig ér – ott találkozik vele a bronz vessző. */
  @media (min-width: 64em) {
    .hero {
      padding-top: var(--space-16);
    }
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      min-height: min(40rem, 70vh);
    }
    .hero :global(.hero__valance) {
      display: none;
    }
    .hero__canopy {
      display: block;
      position: absolute;
      top: calc(-1 * var(--space-16));
      bottom: calc(-1 * var(--space-16));
      right: calc(50% - 50vw);
      width: 50vw;
      max-width: 54rem;
      pointer-events: none;
      -webkit-mask-image: linear-gradient(to left, #000 62%, transparent 100%);
      mask-image: linear-gradient(to left, #000 62%, transparent 100%);
    }
    .hero__layer,
    .hero__layer img {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    /* az SVG „xMaxYMin slice” viselkedése: kitölt, jobb felső sarokhoz igazítva */
    .hero__layer img {
      object-fit: cover;
      object-position: right top;
    }
    .hero__paths {
      margin-top: var(--space-16);
    }
  }

  /* ---------- Belépő mozgás (ritkán látott, egyszeri) ----------
     A cím soronként, maszkból emelkedik; a bevezető csak elmozdul (nem halványul –
     így az LCP-elem az első képkockától látszik); a többi elem rövid lépcsőzéssel
     követi. Minden 1,6 s-on belül nyugalomba kerül. */
  @media (prefers-reduced-motion: no-preference) {
    .hero .eyebrow {
      animation: hero-rise 700ms var(--ease-out) 60ms both;
    }
    .hero .eyebrow::before {
      transform-origin: left center;
      animation: hero-rule 900ms var(--ease-in-out) 40ms both;
    }
    .hero__line-in {
      animation: hero-line 1000ms var(--ease-out) 120ms both;
    }
    .hero__em .hero__line-in {
      animation-delay: 230ms;
    }
    .hero__lead {
      animation: hero-nudge 1100ms var(--ease-out) 300ms both;
    }
    .hero__actions {
      animation: hero-rise 800ms var(--ease-out) 420ms both;
    }
    .hero__lines > div {
      animation: hero-rise 800ms var(--ease-out) 520ms both;
    }
    .hero__lines > div:nth-child(2) {
      animation-delay: 590ms;
    }
    .hero__lines > div:nth-child(3) {
      animation-delay: 660ms;
    }
    .paths::before {
      animation: hero-rule 1300ms var(--ease-in-out) 850ms both;
    }
    .paths > li {
      animation: hero-rise 800ms var(--ease-out) 1150ms both;
    }
    .paths > li:nth-child(2) {
      animation-delay: 1220ms;
    }
    .paths > li:nth-child(3) {
      animation-delay: 1290ms;
    }
  }

  /* Asztali korona mozgása – mindkettő a kompozitorban fut, csak transform/rotate:
     1. Egyszeri, csillapodó „megnyugvás”: a két réteg a jobb felső sarok körül, eltérő
        fázissal és amplitúdóval leng ki, majd ~4,6 s-ra nyugalomba kerül (önálló `rotate`).
     2. Görgetéshez kötött mélység: a hátsó réteg lassabban halad, mint az első (CSS
        scroll-timeline, `transform`); ahol nincs támogatás, csak az 1. marad. Nem tartja
        vissza és nem téríti el a görgetést. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 64em) {
    .hero__layer {
      transform-origin: right top;
    }
    .hero__layer--front {
      --settle: 0.55deg;
      animation: hero-settle 2400ms cubic-bezier(0.37, 0, 0.63, 1) 2000ms both;
    }
    .hero__layer--back {
      --settle: -0.4deg;
      animation: hero-settle 2600ms cubic-bezier(0.37, 0, 0.63, 1) 1700ms both;
    }
    @supports (animation-timeline: scroll()) {
      .hero__layer--front {
        animation:
          hero-settle 2400ms cubic-bezier(0.37, 0, 0.63, 1) 2000ms both,
          hero-depth-front linear both;
      }
      .hero__layer--back {
        animation:
          hero-settle 2600ms cubic-bezier(0.37, 0, 0.63, 1) 1700ms both,
          hero-depth-back linear both;
      }
    }
  }
  /* Az idővonal külön szabályban: a rövidítés (animation) a specifikáció szerint
     visszaállítja, a minifikáló pedig különben beolvasztaná – akkor hatástalan lenne. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 64em) {
      .hero__canopy > .hero__layer {
        animation-timeline: auto, scroll(root block);
        animation-range:
          normal,
          0 100vh;
      }
    }
  }
  @keyframes hero-settle {
    0% {
      rotate: 0deg;
    }
    32% {
      rotate: var(--settle);
    }
    60% {
      rotate: calc(var(--settle) * -0.42);
    }
    82% {
      rotate: calc(var(--settle) * 0.14);
    }
    100% {
      rotate: 0deg;
    }
  }

  @keyframes hero-depth-back {
    to {
      transform: translateY(90px);
    }
  }
  @keyframes hero-depth-front {
    to {
      transform: translateY(36px);
    }
  }

  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes hero-nudge {
    from {
      transform: translateY(10px);
    }
  }
  @keyframes hero-rule {
    from {
      transform: scaleX(0);
    }
  }
</style>
