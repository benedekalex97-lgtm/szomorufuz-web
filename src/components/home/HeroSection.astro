---
import Willow from '@/components/brand/Willow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Homepage } from '@/content/types';
import { central } from '@/content/data/contact';
import { telHref } from '@/lib/format';

interface Props {
  hero: Homepage['hero'];
}
const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-cim">
  <div class="container container--wide hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-cim" class="hero__title">
        {hero.title}
        <span class="hero__em">{hero.titleEmphasis}</span>
      </h1>
      <p class="hero__lead">{hero.lead}</p>

      <div class="hero__actions">
        <Button href={telHref(central.info.phone.e164)} icon="phone" size="lg">
          Hívás: {central.info.phone.display}
        </Button>
        <Button
          href={hero.secondaryCta.href}
          variant="secondary"
          size="lg"
          icon="arrow-right"
          iconPosition="end"
        >
          {hero.secondaryCta.label}
        </Button>
      </div>

      <dl class="hero__lines">
        {[central.info, central.transport, central.office].map((line) => (
          <div>
            <dt>{line.label}</dt>
            <dd>
              <a href={telHref(line.phone.e164)}>{line.phone.display}</a>
              {line.note && <span>{line.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__art" aria-hidden="true">
      <Willow variant="hero" seed={7} animate />
    </div>
  </div>

  <nav class="container container--wide hero__paths" aria-labelledby="hero-utak">
    <h2 id="hero-utak" class="visually-hidden">
      Miben segíthetünk?
    </h2>
    <ul class="paths" role="list">
      {hero.paths.map((path) => (
        <li>
          <a class="hpath" href={path.href}>
            <span class="hpath__label">{path.label}</span>
            <span class="hpath__title">{path.title}</span>
            <span class="hpath__body">{path.body}</span>
            <Icon name="arrow-right" size={20} class="hpath__icon" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--space-10);
  }
  .hero__inner {
    position: relative;
    display: grid;
  }
  .hero__content {
    position: relative;
    z-index: 1;
  }
  .hero__content > * + * {
    margin-top: var(--space-6);
  }
  .hero__title {
    font-size: var(--text-display);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .hero__em {
    display: block;
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent-text);
  }
  .hero__lead {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 30rem;
  }
  .hero__actions {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }
  .hero__lines {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(184 170 152 / 0.7);
    max-width: 40rem;
  }
  .hero__lines dt {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .hero__lines dd a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .hero__lines dd a:hover {
    color: var(--color-accent-text);
  }
  .hero__lines dd span {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  @media (min-width: 40em) {
    .hero__lines {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Egy vonalba kerüljenek a számok akkor is, ha a címke két sorba törik */
    .hero__lines dt {
      min-height: 2.9em;
    }
  }

  /* Mobilon a fa halványan a cím mögött, jobbra igazítva */
  .hero__art {
    position: absolute;
    top: -2.5rem;
    right: -5.5rem;
    width: 17rem;
    opacity: 0.32;
    pointer-events: none;
  }

  /* Mobilon a talajvonal keretnek hatna a szöveg mögött */
  .hero__art :global(.willow__ground) {
    display: none;
  }

  .hero__paths {
    position: relative;
    margin-top: var(--space-12);
  }
  .paths {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-text);
  }
  .hpath {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid rgb(184 170 152 / 0.8);
    color: var(--color-text);
    text-decoration: none;
  }
  .hpath__label {
    grid-column: 1;
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .hpath__title {
    grid-column: 1;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.2;
  }
  .hpath__body {
    grid-column: 1;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .hpath :global(.hpath__icon) {
    grid-column: 2;
    grid-row: 1 / span 3;
    color: var(--color-accent-decor);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .hpath:hover .hpath__title {
    color: var(--color-accent-text);
  }
  .hpath:hover :global(.hpath__icon) {
    transform: translateX(4px);
  }

  @media (min-width: 30em) {
    .hero__art {
      width: 21rem;
      right: -5rem;
    }
  }

  @media (min-width: 40em) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 48em) {
    .paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .hpath {
      height: 100%;
      padding: var(--space-6) var(--space-6) var(--space-8) 0;
      border-bottom: 0;
      align-items: start;
    }
    .paths li + li .hpath {
      padding-inline-start: var(--space-6);
      border-left: 1px solid rgb(184 170 152 / 0.8);
    }
  }

  @media (min-width: 64em) {
    .hero {
      padding-top: var(--space-16);
    }
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      min-height: min(40rem, 70vh);
    }
    .hero__art {
      position: relative;
      top: auto;
      right: auto;
      width: 100%;
      max-width: 30rem;
      justify-self: end;
      opacity: 1;
      margin-top: -2rem;
    }
    .hero__art :global(.willow__ground) {
      display: inline;
    }
    .hero__paths {
      margin-top: var(--space-16);
    }
  }
</style>
