---
import PendingBadge from '@/components/ui/PendingBadge.astro';
import PendingNotice from '@/components/ui/PendingNotice.astro';
import Section from '@/components/ui/Section.astro';
import type { Homepage } from '@/content/types';
import { publishable } from '@/lib/facts';

interface Props {
  data: Homepage['trust'];
}
const { data } = Astro.props;
// Csak megerősített céges tény jelenhet meg (nincs kitalált évszám, díj, vélemény).
const points = data.points
  .map((point) => ({ point, fact: publishable(point.fact) }))
  .filter((p) => p.fact !== null);
---

<Section id="miert-mi" eyebrow="Bizalom" title={data.title} intro={data.intro} tone="alt">
  {points.length > 0 ? (
    <ul class="trust" role="list">
      {points.map(({ point, fact }) => (
        <li class="trust__item">
          <h3 class="trust__title">
            {point.title}
            {fact?.pending && <PendingBadge />}
          </h3>
          <p class="trust__body">{point.body}</p>
        </li>
      ))}
    </ul>
  ) : (
    <PendingNotice title="Ellenőrzött céges tények szükségesek">
      <p>
        Ez a szekció kizárólag a Szomorúfűz által megerősített tényekkel töltődik fel (pl. irodák
        száma, saját ravatalozó, szolgáltatási kör). Működési évek, ügyfélszám, díjak vagy
        vélemények csak igazolt forrással kerülhetnek ide.
      </p>
    </PendingNotice>
  )}
</Section>

<style>
  .trust {
    display: grid;
    gap: var(--space-8);
    padding: 0;
    list-style: none;
  }
  .trust__item {
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-accent-decor);
  }
  .trust__title {
    font-size: var(--text-xl);
  }
  .trust__body {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  @media (min-width: 48em) {
    .trust {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
