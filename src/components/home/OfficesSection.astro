---
import Section from '@/components/ui/Section.astro';
import type { Homepage, Office } from '@/content/types';
import OfficeCard from './OfficeCard.astro';

interface Props {
  data: Homepage['offices'];
  offices: Office[];
}
const { data, offices } = Astro.props;
---

<Section id="irodak" eyebrow="Személyesen" title={data.title} intro={data.intro}>
  <ul class="offices" role="list">
    {offices.map((office) => (
      <li>
        <OfficeCard office={office} />
      </li>
    ))}
  </ul>
  <p class="offices__cta">
    <a href={data.cta.href}>{data.cta.label}</a>
  </p>
</Section>

<style>
  .offices {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .offices__cta {
    margin-top: var(--space-8);
  }
  .offices__cta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-semibold);
  }
  @media (min-width: 40em) {
    .offices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .offices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
