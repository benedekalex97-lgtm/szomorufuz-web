---
import LeafMark from '@/components/brand/LeafMark.astro';
import PendingBadge from '@/components/ui/PendingBadge.astro';
import type { Homepage } from '@/content/types';
import { publishable } from '@/lib/facts';

interface Props {
  data: Homepage['about'];
}
const { data } = Astro.props;
// Céges tény csak ellenőrzötten (review módban jelölve) – kitalált adat nincs.
const facts = data.facts
  .map((f) => ({ ...f, pub: publishable(f.fact) }))
  .filter((f) => f.pub !== null);
---

<section id="rolunk" class="about" aria-labelledby="rolunk-cim">
  <div class="container">
    <p class="eyebrow">{data.eyebrow}</p>
    <h2 id="rolunk-cim" class="visually-hidden">
      {data.eyebrow}
    </h2>
    <blockquote class="about__quote">
      <p>{data.quote}</p>
    </blockquote>

    <ul class="principles" role="list">
      {data.principles.map((p) => (
        <li class="principle">
          <LeafMark size={20} />
          <h3 class="principle__title">{p.title}</h3>
          <p class="principle__body">{p.body}</p>
        </li>
      ))}
    </ul>

    {facts.length > 0 && (
      <ul class="facts" role="list">
        {facts.map((f) => (
          <li>
            <strong>{f.title}</strong> – {f.body}
            {f.pub?.pending && <PendingBadge />}
          </li>
        ))}
      </ul>
    )}
    <p class="about__more">
      <a href="/rolunk/">Ismerjen meg minket</a>
    </p>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-space);
  }
  .about__quote {
    margin-top: var(--space-6);
  }
  .about__quote p {
    max-width: 22ch;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 300;
    font-style: italic;
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .principles {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-16);
    padding: 0;
    list-style: none;
  }
  .principle {
    padding-top: var(--space-5);
    border-top: 1px solid rgb(184 170 152 / 0.8);
  }
  .principle__title {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 400;
  }
  .principle__body {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  .facts {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-10);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .about__more {
    margin-top: var(--space-10);
  }
  .about__more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-medium);
  }
  @media (min-width: 48em) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-10);
    }
  }
  @media (min-width: 64em) {
    .about__quote p {
      font-size: clamp(2.75rem, 1.6rem + 2.8vw, 4rem);
    }
  }
</style>
