---
import Accordion from '@/components/ui/Accordion.astro';
import PendingNotice from '@/components/ui/PendingNotice.astro';
import Section from '@/components/ui/Section.astro';
import type { FaqItem, Homepage } from '@/content/types';

interface Props {
  data: Homepage['faq'];
  items: FaqItem[];
  id?: string;
  tone?: 'default' | 'alt' | 'paper';
}
const { data, items, id = 'gyik', tone = 'paper' } = Astro.props;
const isDemo = items.some((item) => item.copyStatus !== 'approved');
---

<Section
  id={id}
  eyebrow={data.eyebrow}
  title={data.title}
  intro={data.intro}
  tone={tone}
  layout="split"
>
  <Fragment slot="header-extra">
    {isDemo && (
      <PendingNotice title="Mintatartalom">
        <p>
          A kérdések és válaszok demonstrációs célúak; a végleges szöveg jóváhagyás után kerül ide.
        </p>
      </PendingNotice>
    )}
  </Fragment>
  <Accordion items={items} />
  <p class="faq__cta">
    <a href={data.cta.href}>{data.cta.label}</a>
  </p>
</Section>

<style>
  .faq__cta {
    margin-top: var(--space-6);
  }
  .faq__cta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-medium);
  }
</style>
