---
import Accordion from '@/components/ui/Accordion.astro';
import Section from '@/components/ui/Section.astro';
import type { Homepage } from '@/content/types';
import { inline } from '@/lib/inline';

interface Props {
  data: Homepage['faq'];
  items: { q: string; a: string }[];
  id?: string;
  tone?: 'default' | 'alt' | 'paper';
}
const { data, items, id = 'gyik', tone = 'paper' } = Astro.props;
---

<Section
  id={id}
  eyebrow={data.eyebrow}
  title={data.title}
  intro={data.intro}
  tone={tone}
  layout="split"
>
  <Accordion
    items={items.map((f, i) => ({ id: `f${i}`, question: f.q, answer: inline(f.a), html: true }))}
  />
  <p class="faq__cta">
    <a href={data.cta.href}>{data.cta.label}</a>
  </p>
</Section>

<style>
  .faq__cta {
    margin-top: var(--space-6);
  }
  .faq__cta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-medium);
  }
</style>
