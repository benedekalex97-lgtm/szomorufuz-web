---
import Card from '@/components/ui/Card.astro';
import Section from '@/components/ui/Section.astro';
import type { Homepage, Service } from '@/content/types';

interface Props {
  data: Homepage['services'];
  services: Service[];
}
const { data, services } = Astro.props;
---

<Section id="szolgaltatasok" eyebrow="Szolgáltatások" title={data.title} intro={data.intro}>
  <ul class="services" role="list">
    {services.map((service) => (
      <li>
        <Card title={service.title} href={service.href} linkLabel="Részletek">
          <p>{service.summary}</p>
        </Card>
      </li>
    ))}
  </ul>
  <p class="services__cta">
    <a href={data.cta.href}>{data.cta.label}</a>
  </p>
</Section>

<style>
  .services {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .services__cta {
    margin-top: var(--space-8);
  }
  .services__cta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-semibold);
  }
  @media (min-width: 40em) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 75em) {
    .services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
