---
/**
 * Az öt iroda: a kerület római száma a tipográfiai hangsúly.
 * Adatforrás: content/data/contact.ts (élő oldal /elerhetoseg/).
 */
import Icon from '@/components/ui/Icon.astro';
import type { Office } from '@/content/types';
import { telHref } from '@/lib/format';

interface Props {
  offices: Office[];
  headingLevel?: 3 | 4;
  /** Megközelítési leírás megjelenítése (Kapcsolat oldal) */
  detailed?: boolean;
}
const { offices, headingLevel = 3, detailed = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<ul class:list={['offices', detailed && 'offices--detailed']} role="list">
  {offices.map((office) => (
    <li class="office" id={office.slug}>
      <span class="office__numeral" aria-hidden="true">
        {office.numeral}
      </span>
      <div class="office__text">
        <Heading class="office__name">
          {office.name}
          <span class="office__district">{office.district}</span>
        </Heading>
        <p class="office__address">
          {office.postalCode} {office.locality}, {office.street}
        </p>
        <dl class="office__phones">
          <div>
            <dt>Telefon</dt>
            <dd>
              <a href={telHref(office.landline.e164)}>
                {office.landline.display}
                <span class="visually-hidden"> – {office.name}, vezetékes</span>
              </a>
            </dd>
          </div>
          <div>
            <dt>Mobil</dt>
            <dd>
              <a href={telHref(office.mobile.e164)}>
                {office.mobile.display}
                <span class="visually-hidden"> – {office.name}, mobil</span>
              </a>
            </dd>
          </div>
        </dl>
        {detailed && <p class="office__directions">{office.directions}</p>}
        <a href={office.mapUrl} class="office__map" target="_blank" rel="noopener noreferrer">
          Útvonaltervezés
          <span class="visually-hidden"> – {office.name}, Google Térkép, új lapon nyílik</span>
          <Icon name="external-link" size={14} />
        </a>
      </div>
    </li>
  ))}
</ul>

<style>
  .offices {
    display: grid;
    padding: 0;
    list-style: none;
  }
  .office {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-6);
    border-top: 1px solid rgb(184 170 152 / 0.8);
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
  }
  .office__numeral {
    white-space: nowrap;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-accent-decor);
  }
  .office__name {
    font-size: var(--text-xl);
    font-weight: 400;
  }
  .office__district {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-top: var(--space-1);
  }
  .office__address {
    margin-top: var(--space-3);
    font-weight: var(--weight-medium);
  }
  .office__phones {
    margin-top: var(--space-2);
    display: grid;
    gap: 0;
  }
  .office__phones > div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .office__phones dt {
    min-width: 4.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .office__phones a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    text-decoration-color: rgb(137 116 93 / 0.6);
  }
  .office__phones a:hover {
    color: var(--color-accent-text);
  }
  .office__directions {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 34rem;
  }
  .office__map {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 64em) {
    .offices:not(.offices--detailed) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-6);
      border-top: 1px solid var(--color-text);
    }
    .offices:not(.offices--detailed) .office {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-top: var(--space-6);
      border-top: 0;
    }
    .offices:not(.offices--detailed) .office__numeral {
      font-size: 3.5rem;
    }
    .offices--detailed {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-12);
    }
    .offices--detailed .office {
      grid-template-columns: 7.5rem 1fr;
    }
    .offices--detailed .office__numeral {
      font-size: 2.75rem;
    }
  }
</style>
