---
/** Sötét „azonnali segítség” panel – a központi számokkal (szerepük szerint). */
import Icon from '@/components/ui/Icon.astro';
import { central } from '@/content/data/contact';
import { telHref } from '@/lib/format';

interface Props {
  title?: string;
}
const { title = 'Haláleset történt?' } = Astro.props;
---

<aside class="help-panel" aria-label="Azonnali segítség">
  <p class="help-panel__title">{title}</p>
  <p class="help-panel__text">
    Vegye fel velünk mielőbb a kapcsolatot – a többit elintézzük Ön helyett.
  </p>
  <dl class="help-panel__lines">
    {[central.info, central.transport].map((line) => (
      <div>
        <dt>{line.label}</dt>
        <dd>
          <a class="help-panel__link" href={telHref(line.phone.e164)}>
            <Icon name="phone" size={18} /> {line.phone.display}
          </a>
          {line.note && <span class="help-panel__note">{line.note}</span>}
        </dd>
      </div>
    ))}
  </dl>
</aside>

<style>
  .help-panel {
    padding: var(--space-6);
    background-color: var(--color-ink-bg);
    color: var(--color-ink-text);
    max-width: 26rem;
  }
  .help-panel__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }
  .help-panel__text {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
  .help-panel__lines > div {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-ink-line);
  }
  .help-panel__lines dt {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-accent);
  }
  .help-panel__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    color: var(--color-ink-text);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .help-panel__link:hover {
    color: var(--palette-white);
  }
  .help-panel :focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }
  .help-panel__note {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
</style>
