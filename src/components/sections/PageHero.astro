---
/** Aloldal-fejléc: morzsamenü, címke, kétsoros cím dőlt kiemeléssel, bevezető. */
import CanopyCorner from '@/components/brand/CanopyCorner.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import type { Link } from '@/content/types';

interface Props {
  eyebrow: string;
  title: string;
  titleEmphasis?: string | undefined;
  lead: string;
  breadcrumbs: Link[];
  /** Elavult (a korábbi generált fához) – figyelmen kívül hagyva */
  seed?: number;
}
const { eyebrow, title, titleEmphasis, lead, breadcrumbs } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero__art" aria-hidden="true">
    <CanopyCorner eager />
  </div>
  <div class="container page-hero__inner">
    <Breadcrumbs items={breadcrumbs} />
    <div class="page-hero__text">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="page-hero__title">
        {title}
        {titleEmphasis && <span class="em page-hero__em">{titleEmphasis}</span>}
      </h1>
      <p class="page-hero__lead">{lead}</p>
      <slot />
    </div>
    <slot name="aside" />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) var(--space-16);
    border-bottom: 1px solid rgb(184 170 152 / 0.7);
  }
  /* A korona a jobb felső sarokból lóg be, a szöveg felé és lefelé feloldódva */
  .page-hero__art {
    position: absolute;
    top: 0;
    right: 0;
    width: min(24rem, 64vw);
    opacity: 0.55;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to left, #000 45%, transparent 100%);
    mask-image: linear-gradient(to left, #000 45%, transparent 100%);
  }
  @media (min-width: 64em) {
    .page-hero__art {
      width: 34rem;
      opacity: 1;
    }
  }
  .page-hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-10);
  }
  .page-hero__text {
    margin-top: var(--space-6);
  }
  .page-hero__text > * + * {
    margin-top: var(--space-5);
  }
  .page-hero__title {
    font-size: var(--text-4xl);
    font-weight: 300;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .page-hero__em {
    display: block;
  }
  .page-hero__lead {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 36rem;
  }
  @media (min-width: 64em) {
    .page-hero {
      padding-block: var(--space-8) var(--space-20);
    }
    .page-hero__art {
      right: -3rem;
      width: 24rem;
      opacity: 0.4;
    }
    .page-hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
    }
    .page-hero__inner > :global(nav) {
      grid-column: 1 / -1;
    }
  }
</style>
