---
/** Sötét záró sáv: a központi elérhetőségek szerepük szerint, valamint árajánlat és teendők. */
import Willow from '@/components/brand/Willow.astro';
import Button from '@/components/ui/Button.astro';
import { central } from '@/content/data/contact';
import { telHref } from '@/lib/format';

interface Props {
  title?: string;
  intro?: string;
  id?: string;
}
const {
  title = 'Hívjon minket bizalommal',
  intro = 'Információ 6:00 és 22:00 óra között, ügyeleti halottszállítás, vagy személyesen öt budapesti irodánkban.',
  id = 'kapcsolat',
} = Astro.props;
const lines = [central.info, central.transport, central.office];
---

<section id={id} class="cta" aria-labelledby={`${id}-cim`}>
  <div class="cta__art" aria-hidden="true">
    <Willow variant="band" seed={11} />
  </div>
  <div class="container cta__inner">
    <div class="cta__text">
      <p class="eyebrow cta__eyebrow">Kapcsolat</p>
      <h2 id={`${id}-cim`} class="cta__title">
        {title}
      </h2>
      <p class="cta__intro">{intro}</p>
      <div class="cta__actions">
        <Button
          href="/arajanlat-keres-itt/"
          variant="inverse"
          icon="arrow-right"
          iconPosition="end"
        >
          Árajánlat kérése
        </Button>
        <Button href="/teendok-halaleset-utan/" variant="inverse-outline">
          Teendők haláleset után
        </Button>
      </div>
    </div>
    <dl class="cta__lines">
      {lines.map((line) => (
        <div>
          <dt>{line.label}</dt>
          <dd>
            <a href={telHref(line.phone.e164)}>{line.phone.display}</a>
            {line.note && <span>{line.note}</span>}
          </dd>
        </div>
      ))}
      <div>
        <dt>E-mail</dt>
        <dd>
          <a href={`mailto:${central.email}`} class="cta__email">
            {central.email}
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-space);
    background-color: var(--color-ink-bg);
    color: var(--color-ink-text);
    border-bottom: 1px solid var(--color-ink-line);
  }
  .cta__art {
    position: absolute;
    left: -8rem;
    bottom: -4rem;
    width: min(30rem, 90vw);
    opacity: 0.18;
    pointer-events: none;
    --willow-stem: var(--color-ink-accent);
    --willow-leaf: var(--color-ink-accent);
  }
  .cta__inner {
    position: relative;
    display: grid;
    gap: var(--space-10);
  }
  .cta__text > * + * {
    margin-top: var(--space-4);
  }
  .cta__eyebrow {
    color: var(--color-ink-accent);
  }
  .cta__title {
    color: var(--color-ink-text);
    font-size: var(--text-3xl);
    font-weight: 300;
    max-width: 16ch;
  }
  .cta__intro {
    color: var(--color-ink-muted);
    font-size: var(--text-lg);
    max-width: 34rem;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  .cta__lines > div {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-ink-line);
  }
  .cta__lines > div:first-child {
    border-top: 1px solid var(--color-ink-accent);
  }
  .cta__lines dt {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-accent);
  }
  .cta__lines dd a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-ink-text);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .cta__lines dd a.cta__email {
    font-family: var(--font-body);
    font-size: var(--text-base);
    text-decoration: underline;
    text-decoration-color: var(--color-ink-accent);
  }
  .cta__lines dd a:hover {
    color: var(--palette-white);
  }
  .cta__lines dd span {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .cta :focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }
  @media (min-width: 64em) {
    .cta__inner {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: var(--space-16);
    }
  }
</style>
