---
import Willow from '@/components/brand/Willow.astro';
import Logo from '@/components/ui/Logo.astro';
import { central, company, officeHours } from '@/content/data/contact';
import { getNavigation, getOffices } from '@/lib/content';

const [navigation, offices] = await Promise.all([getNavigation(), getOffices()]);
const year = new Date().getFullYear();

const services = [
  { label: 'Hamvasztás', href: '/hamvasztasos-temetes/' },
  { label: 'Hagyományos temetés', href: '/koporsos-temetes/' },
  { label: 'Hamvak szórása', href: '/hamvak-szorasa-temeto/' },
  { label: 'Hajós temetés', href: '/hamvak-szorasa-dunaba/' },
  { label: 'Minden szolgáltatás', href: '/szolgaltatasok/' },
];
---

<footer class="site-footer">
  <div class="site-footer__art" aria-hidden="true">
    <Willow variant="band" seed={23} />
  </div>
  <div class="container container--wide site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand-top">
        <Logo tone="inverse" />
        <p class="site-footer__lede">
          Segítünk eligazodni a teendőkben, és támogatást nyújtunk a búcsúztatás megszervezésében.
        </p>
      </div>
      <div class="site-footer__contact">
        <p class="site-footer__label">Ügyfélfogadás irodáinkban</p>
        {officeHours.map((h) => (
          <p>
            {h.days}: {h.hours}
          </p>
        ))}
        <p class="site-footer__label">E-mail</p>
        <p>
          <a href={`mailto:${central.email}`}>{central.email}</a>
        </p>
        <p class="site-footer__links">
          <a href="/elerhetoseg/">Elérhetőség és irodák →</a>
        </p>
      </div>
    </div>

    <div class="site-footer__grid">
      <nav aria-labelledby="footer-szolg">
        <h2 id="footer-szolg" class="site-footer__heading">
          Szolgáltatások
        </h2>
        <ul class="site-footer__list" role="list">
          {services.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="footer-info">
        <h2 id="footer-info" class="site-footer__heading">
          Tudnivalók
        </h2>
        <ul class="site-footer__list" role="list">
          {navigation.footerImportant.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="footer-irodak">
        <h2 id="footer-irodak" class="site-footer__heading">
          Irodáink
        </h2>
        <ul class="site-footer__list" role="list">
          {offices.map((office) => (
            <li>
              <a href={`/elerhetoseg/#${office.slug}`}>{office.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <nav aria-label="Jogi információk">
        <ul class="site-footer__legal" role="list">
          {navigation.footerLegal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="site-footer__copy">
        © {year} {company.legalName}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background-color: var(--color-ink-bg);
    color: var(--color-ink-text);
    padding-block: var(--space-16) var(--space-8);
    font-size: var(--text-sm);
  }
  .site-footer__art {
    position: absolute;
    top: -2rem;
    right: -6rem;
    width: min(34rem, 80vw);
    opacity: 0.22;
    pointer-events: none;
    --willow-stem: var(--color-ink-accent);
    --willow-leaf: var(--color-ink-accent);
  }
  .site-footer__inner {
    position: relative;
  }
  .site-footer a {
    color: var(--color-ink-text);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--palette-white);
    text-decoration: underline;
    text-decoration-color: var(--color-ink-accent);
  }
  .site-footer :focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }
  .site-footer__top {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-ink-line);
  }
  .site-footer__lede {
    margin-top: var(--space-4);
    max-width: 36ch;
    color: var(--color-ink-muted);
  }
  .site-footer__contact {
    display: grid;
    gap: var(--space-3);
    align-content: end;
  }
  .site-footer__muted {
    color: var(--color-ink-muted);
    max-width: 30ch;
  }
  .site-footer__contact > p {
    color: var(--color-ink-muted);
  }
  .site-footer__contact > p.site-footer__label {
    margin-top: var(--space-4);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-accent);
  }
  .site-footer__contact > p.site-footer__label:first-child {
    margin-top: 0;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-ink-accent);
  }
  .site-footer__contact dt {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-accent);
  }
  .site-footer__contact dd span {
    display: block;
    color: var(--color-ink-muted);
  }
  .site-footer__phone {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
  }
  .site-footer__muted-inline {
    color: var(--color-ink-muted);
  }
  .site-footer__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    color: var(--color-ink-accent) !important;
    font-weight: var(--weight-medium);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-12);
  }
  .site-footer__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-accent);
  }
  .site-footer__list {
    padding: 0;
    list-style: none;
  }
  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-ink-line);
    color: var(--color-ink-muted);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    padding: 0;
    list-style: none;
  }
  .site-footer__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    color: var(--color-ink-muted);
  }
  .site-footer__copy {
    color: var(--color-ink-muted);
  }
  @media (min-width: 48em) {
    .site-footer__top {
      grid-template-columns: 1.4fr 1fr;
    }
    .site-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
