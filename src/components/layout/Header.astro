---
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { getNavigation, getSiteSettings } from '@/lib/content';
import { verifiedOnly } from '@/lib/facts';
import { telHref } from '@/lib/format';

const [navigation, settings] = await Promise.all([getNavigation(), getSiteSettings()]);
// tel: link CSAK ellenőrzött számra (review módban sem).
const phone = verifiedOnly(settings.primaryPhone);
const helpHref = phone ? telHref(phone.e164) : '/elerhetoseg/';
const currentPath = Astro.url.pathname;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container container--wide site-header__inner">
    <Logo />

    <nav class="site-nav" aria-label="Fő navigáció">
      <ul class="site-nav__list" role="list">
        {navigation.header.map((item) => (
          <li>
            <a
              class="site-nav__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              title={item.description}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="help-link" href={helpHref}>
        <Icon name="phone" size={17} />
        <span>{phone ? phone.display : 'Segítség'}</span>
      </a>

      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobil-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__open">
          <Icon name="menu" size={22} />
        </span>
        <span class="menu-toggle__close">
          <Icon name="x" size={22} />
        </span>
        <span class="menu-toggle__label" data-menu-label>
          Menü
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobil-menu" data-menu hidden>
    <nav class="container" aria-label="Mobil navigáció">
      <ul class="mobile-menu__list" role="list">
        {navigation.primary.map((item) => (
          <li>
            <a
              class="mobile-menu__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-menu__help">
        <p class="mobile-menu__help-title">Haláleset történt?</p>
        <p class="mobile-menu__help-text">Az első lépéseket nyugodt sorrendben mutatjuk meg.</p>
        <a class="mobile-menu__help-link" href="/teendok-halaleset-utan/">
          Teendők haláleset esetén
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="mobile-menu__help-link" href={helpHref}>
          {phone ? `Hívás: ${phone.display}` : 'Kapcsolat'}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Disclosure-minta: aria-expanded + hidden. Escape bezár és visszaadja a fókuszt.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');
  const desktop = window.matchMedia('(min-width: 75em)');

  if (header && toggle && menu) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      // A panel pontosan a fejléc aljától a képernyő aljáig érjen (a bemutató-sáv miatt is)
      if (open)
        menu.style.height = `${window.innerHeight - header.getBoundingClientRect().bottom}px`;
      menu.hidden = !open;
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (label) label.textContent = open ? 'Bezárás' : 'Menü';
      if (!open && restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) setOpen(false, true);
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });

    // Görgetéskor finom árnyék a fejlécen
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: rgb(247 245 240 / 0.94);
    backdrop-filter: saturate(1.1) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    border-bottom-color: rgb(184 170 152 / 0.6);
  }

  :global(.no-js) .site-header {
    position: static;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-3);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0.7rem;
    height: 1px;
    background-color: var(--color-accent-decor);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-accent-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .help-link {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
    font-size: 0.875rem;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .help-link:hover {
    background-color: var(--color-action-primary-bg-hover);
    color: var(--color-action-primary-text);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: 0.875rem;
    font-weight: var(--weight-medium);
  }

  .menu-toggle:hover {
    border-color: var(--color-text);
  }

  /* Kis kijelzőn csak ikon látszik, de a felirat a képernyőolvasónak megmarad */
  .menu-toggle__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .menu-toggle__close,
  .site-header.is-open .menu-toggle__open {
    display: none;
  }

  .site-header.is-open .menu-toggle__close,
  .menu-toggle__open {
    display: inline-flex;
  }

  :global(.no-js) .menu-toggle {
    display: none;
  }

  :global(.no-js) .mobile-menu[hidden] {
    display: block;
    position: static;
    height: auto;
  }

  /* Mobilmenü: teljes magasságú panel a fejléc alatt */
  .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: calc(100dvh - 100%);
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--color-bg);
    padding-block: var(--space-4) var(--space-10);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in var(--duration-base) var(--ease-standard);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .mobile-menu__list {
    padding: 0;
    list-style: none;
  }

  .mobile-menu__list li + li {
    border-top: 1px solid rgb(184 170 152 / 0.5);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 350;
    text-decoration: none;
  }

  .mobile-menu__link[aria-current='page'] {
    color: var(--color-accent-text);
    font-style: italic;
  }

  .mobile-menu__help {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background-color: var(--color-ink-bg);
    color: var(--color-ink-text);
  }

  .mobile-menu__help-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }

  .mobile-menu__help-text {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .mobile-menu__help-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--tap-target);
    margin-top: var(--space-2);
    border-bottom: 1px solid var(--color-ink-line);
    color: var(--color-ink-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .mobile-menu__help-link:hover {
    color: var(--palette-white);
  }

  .mobile-menu__help :focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }

  @media (min-width: 24em) {
    .help-link {
      display: inline-flex;
    }
  }

  @media (min-width: 40em) {
    .menu-toggle__label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      min-width: 4.25em;
      text-align: left;
    }
  }

  @media (min-width: 75em) {
    .site-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu,
    :global(.no-js) .mobile-menu[hidden] {
      display: none;
    }
    .help-link {
      min-height: var(--tap-target);
      padding-inline: 1.25rem;
    }
  }
</style>
