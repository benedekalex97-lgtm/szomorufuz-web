---
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { getNavigation, getSiteSettings } from '@/lib/content';
import { verifiedOnly } from '@/lib/facts';
import { telHref } from '@/lib/format';

const [navigation, settings] = await Promise.all([getNavigation(), getSiteSettings()]);
// tel: link CSAK ellenőrzött számra (review módban sem).
const phone = verifiedOnly(settings.primaryPhone);
const helpHref = phone ? telHref(phone.e164) : '/elerhetoseg/';
const currentPath = Astro.url.pathname;

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container container--wide site-header__inner">
    <Logo />

    <nav class="site-nav" aria-label="Fő navigáció">
      <ul class="site-nav__list" role="list">
        {navigation.header.map((item) => (
          <li>
            <a
              class="site-nav__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              title={item.description}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="help-link" href={helpHref}>
        <Icon name="phone" size={17} />
        <span>{phone ? phone.display : 'Segítség'}</span>
      </a>

      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobil-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__icon" aria-hidden="true">
          <span class="menu-toggle__open">
            <Icon name="menu" size={22} />
          </span>
          <span class="menu-toggle__close">
            <Icon name="x" size={22} />
          </span>
        </span>
        <span class="menu-toggle__label" data-menu-label>
          Menü
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobil-menu" data-menu hidden>
    <nav class="container" aria-label="Mobil navigáció">
      <ul class="mobile-menu__list" role="list">
        {navigation.primary.map((item) => (
          <li>
            <a
              class="mobile-menu__link"
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-menu__help">
        <p class="mobile-menu__help-title">Haláleset történt?</p>
        <p class="mobile-menu__help-text">Az első lépéseket nyugodt sorrendben mutatjuk meg.</p>
        <a class="mobile-menu__help-link" href="/teendok-halaleset-utan/">
          Teendők haláleset esetén
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="mobile-menu__help-link" href={helpHref}>
          {phone ? `Hívás: ${phone.display}` : 'Kapcsolat'}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Disclosure-minta: aria-expanded + hidden. Escape bezár és visszaadja a fókuszt.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');
  const desktop = window.matchMedia('(min-width: 75em)');

  if (header && toggle && menu) {
    // Mozgás: érintéssel/egérrel nyitva a panel beúszik, záráskor gyorsan eltűnik.
    // Billentyűzettel (Enter, Szóköz, Escape) nincs animáció – azonnal reagál.
    const EXIT_MS = 160;
    let closeTimer = 0;
    const finishClose = () => {
      window.clearTimeout(closeTimer);
      menu.hidden = true;
      menu.removeAttribute('data-closing');
    };

    const setOpen = (open: boolean, opts: { restoreFocus?: boolean; instant?: boolean } = {}) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-instant', Boolean(opts.instant));
      if (open) {
        finishClose();
        // A panel pontosan a fejléc aljától a képernyő aljáig érjen (a bemutató-sáv miatt is)
        menu.style.height = `${window.innerHeight - header.getBoundingClientRect().bottom}px`;
        menu.hidden = false;
      } else if (opts.instant) {
        finishClose();
      } else if (!menu.hidden) {
        menu.setAttribute('data-closing', '');
        closeTimer = window.setTimeout(finishClose, EXIT_MS);
      }
      header.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      if (label) label.textContent = open ? 'Bezárás' : 'Menü';
      if (!open && opts.restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', (event) => {
      // event.detail === 0: billentyűzettel kiváltott kattintás
      setOpen(toggle.getAttribute('aria-expanded') !== 'true', { instant: event.detail === 0 });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden)
        setOpen(false, { restoreFocus: true, instant: true });
    });

    // Linkre kattintva az oldal úgyis vált – nincs mit animálni
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a'))
        setOpen(false, { instant: true });
    });

    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false, { instant: true });
    });

    // Görgetéskor finom árnyék a fejlécen
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: rgb(247 245 240 / 0.94);
    backdrop-filter: saturate(1.1) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    border-bottom-color: rgb(184 170 152 / 0.6);
  }

  :global(.no-js) .site-header {
    position: static;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-3);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0.7rem;
    height: 1px;
    background-color: var(--color-accent-decor);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-accent-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .help-link {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
    font-size: 0.875rem;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .help-link:hover {
    background-color: var(--color-action-primary-bg-hover);
    color: var(--color-action-primary-text);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: 0.875rem;
    font-weight: var(--weight-medium);
  }

  .menu-toggle:hover {
    border-color: var(--color-text);
  }

  /* Kis kijelzőn csak ikon látszik, de a felirat a képernyőolvasónak megmarad */
  .menu-toggle__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* A két ikon egymáson; nyitáskor áttűnnek (állapotjelzés) */
  .menu-toggle__icon {
    display: inline-grid;
  }
  .menu-toggle__open,
  .menu-toggle__close {
    grid-area: 1 / 1;
    display: inline-flex;
    transition:
      opacity var(--duration-press) ease,
      transform 200ms var(--ease-out);
  }
  .menu-toggle__close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.9);
  }
  .site-header.is-open .menu-toggle__open {
    opacity: 0;
    transform: rotate(45deg) scale(0.9);
  }
  .site-header.is-open .menu-toggle__close {
    opacity: 1;
    transform: none;
  }
  .menu-toggle {
    transition:
      border-color var(--duration-base) ease,
      transform var(--duration-press) var(--ease-out);
  }
  .menu-toggle:active {
    transform: scale(0.96);
  }

  :global(.no-js) .menu-toggle {
    display: none;
  }

  :global(.no-js) .mobile-menu[hidden] {
    display: block;
    position: static;
    height: auto;
  }

  /* Mobilmenü: teljes magasságú panel a fejléc alatt */
  .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: calc(100dvh - 100%);
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--color-bg);
    padding-block: var(--space-4) var(--space-10);
  }

  /* Nyitás: a panel felülről beúszik (fiók-görbe), a menüpontok röviden lépcsőznek.
     Zárás: gyorsabb (a rendszer válasza legyen fürge). Megszakítható: átmenetek, nem
     kulcskockák. */
  .mobile-menu {
    transition:
      opacity 240ms var(--ease-drawer),
      transform 300ms var(--ease-drawer);
  }
  @starting-style {
    .mobile-menu:not([hidden]) {
      opacity: 0;
      transform: translateY(-10px);
    }
  }
  .mobile-menu[data-closing] {
    opacity: 0;
    transform: translateY(-6px);
    transition-duration: var(--duration-exit);
    transition-timing-function: var(--ease-out);
  }
  .mobile-menu__list li {
    transition:
      opacity 260ms var(--ease-out),
      transform 320ms var(--ease-out);
    transition-delay: calc(var(--i, 0) * 30ms);
  }
  .mobile-menu__list li:nth-child(2) {
    --i: 1;
  }
  .mobile-menu__list li:nth-child(3) {
    --i: 2;
  }
  .mobile-menu__list li:nth-child(4) {
    --i: 3;
  }
  .mobile-menu__list li:nth-child(5) {
    --i: 4;
  }
  .mobile-menu__list li:nth-child(n + 6) {
    --i: 5;
  }
  @starting-style {
    .mobile-menu:not([hidden]) .mobile-menu__list li {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .mobile-menu[data-closing] .mobile-menu__list li {
    transition-delay: 0ms;
  }
  /* Billentyűzetes nyitás/zárás: azonnali */
  .mobile-menu[data-instant],
  .mobile-menu[data-instant] .mobile-menu__list li {
    transition: none;
  }

  .mobile-menu__list {
    padding: 0;
    list-style: none;
  }

  .mobile-menu__list li + li {
    border-top: 1px solid rgb(184 170 152 / 0.5);
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 350;
    text-decoration: none;
  }

  .mobile-menu__link[aria-current='page'] {
    color: var(--color-accent-text);
    font-style: italic;
  }

  .mobile-menu__help {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background-color: var(--color-ink-bg);
    color: var(--color-ink-text);
  }

  .mobile-menu__help-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
  }

  .mobile-menu__help-text {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }

  .mobile-menu__help-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--tap-target);
    margin-top: var(--space-2);
    border-bottom: 1px solid var(--color-ink-line);
    color: var(--color-ink-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .mobile-menu__help-link:hover {
    color: var(--palette-white);
  }

  .mobile-menu__help :focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }

  @media (min-width: 24em) {
    .help-link {
      display: inline-flex;
    }
  }

  @media (min-width: 40em) {
    .menu-toggle__label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      min-width: 4.25em;
      text-align: left;
    }
  }

  @media (min-width: 75em) {
    .site-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu,
    :global(.no-js) .mobile-menu[hidden] {
      display: none;
    }
    .help-link {
      min-height: var(--tap-target);
      padding-inline: 1.25rem;
    }
  }
</style>
