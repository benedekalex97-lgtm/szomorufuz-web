---
/**
 * Bemutatóverzió-jelzés: egyértelműen elkülöníti a jóváhagyandó tartalmat.
 * Csak nem éles környezetben jelenik meg.
 */
import { allowIndexing } from '@/config/site';
---

{!allowIndexing && (
  <aside class="demo-notice" aria-label="Bemutatóverzió">
    <p>
      <strong>Bemutatóverzió.</strong>
      <span>
        A szövegek tervezetek; a telefonszám, a címek és az árak jóváhagyás után kerülnek fel.
      </span>
    </p>
  </aside>
)}

<style>
  .demo-notice {
    padding: 0.55rem var(--gutter);
    background-color: var(--color-ink-bg);
    color: var(--color-ink-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }
  .demo-notice p {
    max-width: none;
  }
  .demo-notice strong {
    color: var(--color-ink-text);
    font-weight: var(--weight-semibold);
    margin-inline-end: 0.35em;
  }
</style>
