---
/**
 * IDEIGLENES SZÖVEGES LOGÓ. A végleges (galamb + szomorúfűz) embléma külön jóváhagyási pont.
 */
interface Props {
  tone?: 'default' | 'inverse';
  asLink?: boolean;
}
const { tone = 'default', asLink = true } = Astro.props;
const Tag = asLink ? 'a' : 'span';
---

<Tag class:list={['logo', `logo--${tone}`]} href={asLink ? '/' : undefined}>
  <span class="logo__name">Szomorúfűz</span>
  <span class="logo__tagline">Temetkezési szolgáltatások</span>
  {asLink && <span class="visually-hidden"> – főoldal</span>}
</Tag>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: var(--tap-target);
    justify-content: center;
    text-decoration: none;
    color: var(--color-text);
  }
  .logo:hover {
    color: var(--color-text);
  }
  .logo__name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .logo__tagline {
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    line-height: 1.2;
  }
  .logo--inverse,
  .logo--inverse:hover {
    color: var(--color-text-inverse);
  }
  .logo--inverse .logo__tagline {
    color: var(--palette-stone-taupe);
  }
  .logo--inverse:focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }
  @media (min-width: 30em) {
    .logo__tagline {
      letter-spacing: 0.14em;
    }
  }
  @media (min-width: 64em) {
    .logo__name {
      font-size: 1.75rem;
    }
  }
</style>
