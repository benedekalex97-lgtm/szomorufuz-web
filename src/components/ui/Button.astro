---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icons.generated';

type Variant = 'primary' | 'secondary' | 'ghost' | 'inverse' | 'inverse-outline';
type Size = 'md' | 'lg';

type Props = {
  variant?: Variant;
  size?: Size;
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  fullWidth?: boolean;
  class?: string;
} & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'href' | 'class'>)
  | ({ href?: undefined } & Omit<HTMLAttributes<'button'>, 'class'>)
);

const {
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'start',
  fullWidth = false,
  class: className,
  href,
  ...rest
} = Astro.props;
// A gomb típusa felülírható (pl. type="submit" űrlapon); alapértelmezés: "button".
const { type: buttonType = 'button', ...buttonRest } = rest as HTMLAttributes<'button'>;

const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth && 'btn--full',
  icon && iconPosition === 'end' && 'btn--icon-end',
  className,
];
---

{href !== undefined ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
    <span class="btn__label">
      <slot />
    </span>
    {icon && iconPosition === 'end' && <Icon name={icon} size={18} class="btn__end" />}
  </a>
) : (
  <button type={buttonType} class:list={classes} {...buttonRest}>
    {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
    <span class="btn__label">
      <slot />
    </span>
    {icon && iconPosition === 'end' && <Icon name={icon} size={18} class="btn__end" />}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--tap-target);
    padding: 0.8rem 1.5rem;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  .btn--lg {
    min-height: 3.5rem;
    padding-inline: 1.875rem;
    font-size: 1rem;
  }

  .btn--full {
    width: 100%;
  }

  .btn :global(.btn__end) {
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .btn:hover :global(.btn__end) {
    transform: translateX(3px);
  }

  .btn--primary {
    background-color: var(--color-action-primary-bg);
    color: var(--color-action-primary-text);
  }
  .btn--primary:hover {
    background-color: var(--color-action-primary-bg-hover);
    color: var(--color-action-primary-text);
  }

  .btn--secondary {
    background-color: transparent;
    border-color: var(--color-text);
    color: var(--color-text);
  }
  .btn--secondary:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .btn--ghost {
    min-height: var(--tap-target);
    padding-inline: 0;
    background: transparent;
    color: var(--color-text);
    border-radius: 0;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 calc(100% - 0.7rem);
    background-repeat: no-repeat;
  }
  .btn--ghost:hover {
    color: var(--color-accent-text);
  }

  .btn--inverse {
    background-color: var(--color-ink-text);
    color: var(--color-ink-bg);
  }
  .btn--inverse:hover {
    background-color: var(--palette-white);
    color: var(--color-ink-bg);
  }

  .btn--inverse-outline {
    background: transparent;
    border-color: var(--color-ink-muted);
    color: var(--color-ink-text);
  }
  .btn--inverse-outline:hover {
    border-color: var(--color-ink-text);
    background-color: rgb(234 229 218 / 0.08);
    color: var(--color-ink-text);
  }

  .btn--inverse:focus-visible,
  .btn--inverse-outline:focus-visible {
    outline-color: var(--color-focus-ring-inverse);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }
</style>
