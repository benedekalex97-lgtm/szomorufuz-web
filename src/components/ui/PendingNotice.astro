---
/** Jóváhagyásra váró / ellenőrizetlen tartalom helye. Nem tartalmaz kitalált értéket. */
interface Props {
  title?: string;
  tone?: 'light' | 'ink';
  class?: string;
}
const { title = 'Jóváhagyásra vár', tone = 'light', class: className } = Astro.props;
---

<div class:list={['pending', `pending--${tone}`, className]} role="note">
  <p class="pending__title">{title}</p>
  <div class="pending__body">
    <slot />
  </div>
</div>

<style>
  .pending {
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-accent-decor);
    background-color: rgb(234 229 218 / 0.55);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .pending__title {
    margin-bottom: var(--space-1);
    font-size: 0.75rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .pending--ink {
    border-left-color: var(--color-ink-accent);
    background-color: rgb(234 229 218 / 0.06);
    color: var(--color-ink-muted);
  }
  .pending--ink .pending__title {
    color: var(--color-ink-accent);
  }
</style>
