{
  "name": "szomorufuz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Szomorúfűz Temetkezés – új weboldal (Astro + TypeScript)",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa:browser": "node scripts/qa/browser-qa.mjs",
    "qa:deploy": "node scripts/qa/deploy-qa.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "lucide-static": "^1.66.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
