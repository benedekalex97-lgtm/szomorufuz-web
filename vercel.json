{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/arajanlatkeres/",
      "destination": "/arajanlat-keres-itt/",
      "permanent": true
    },
    {
      "source": "/irodak/",
      "destination": "/elerhetoseg/#irodak",
      "permanent": true
    },
    {
      "source": "/suti-tajekoztato/",
      "destination": "/adatkezeles/#sutik",
      "permanent": true
    },
    {
      "source": "/ravatalozo-galeria/",
      "destination": "/ravatalozo-terem/",
      "permanent": true
    },
    {
      "source": "/termek-adatlapok/",
      "destination": "/urnak/",
      "permanent": true
    },
    {
      "source": "/hasznos-linkek/",
      "destination": "/jogszabalyok/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
