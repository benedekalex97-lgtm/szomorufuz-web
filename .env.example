# Másold .env néven, és csak helyben töltsd ki. A .env fájl nincs verziókezelve.
# Titkos kulcs (pl. későbbi SANITY_API_READ_TOKEN) SOHA ne kapjon PUBLIC_ előtagot.

# Környezet: development | preview | production
# Csak "production" esetén engedélyezett az indexelés (robots + meta robots).
PUBLIC_SITE_ENV=development

# Tartalmi mód:
#   strict – csak az ellenőrzött ("verified") üzleti adatok jelennek meg (alapértelmezett)
#   review – az ellenőrizetlen jelölt adatok is látszanak, "Ellenőrzésre vár" jelöléssel,
#            belső átnézéshez. Productionben a kód ezt figyelmen kívül hagyja.
PUBLIC_CONTENT_MODE=strict

# 3. fázis (még nem használt):
# PUBLIC_SANITY_PROJECT_ID=
# PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
