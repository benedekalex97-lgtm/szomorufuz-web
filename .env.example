# Másold .env néven, és csak helyben töltsd ki. A .env fájl nincs verziókezelve.
# Titkos kulcs (pl. későbbi SANITY_API_READ_TOKEN) SOHA ne kapjon PUBLIC_ előtagot.

# Környezet: development | preview | production
# Csak "production" esetén engedélyezett az indexelés (robots + meta robots).
PUBLIC_SITE_ENV=development

# Tartalmi mód:
#   strict – csak az ellenőrzött ("verified") üzleti adatok jelennek meg (alapértelmezett)
#   review – az ellenőrizetlen jelölt adatok is látszanak, "Ellenőrzésre vár" jelöléssel,
#            belső átnézéshez. Productionben a kód ezt figyelmen kívül hagyja.
PUBLIC_CONTENT_MODE=strict

# 3. fázis (még nem használt):
# PUBLIC_SANITY_PROJECT_ID=
# PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=

# ---- Online űrlapok (audit SZF-002) ----
# Mód: disabled | dry-run | smtp
#   disabled – az űrlap látszik, de a küldés ki van kapcsolva (production alapértelmezés)
#   dry-run  – ellenőriz, de semmit nem továbbít (Vercel preview / helyi fejlesztés alapértelmezés)
#   smtp     – valódi küldés; CSAK jóváhagyott adatkezelési tájékoztató után!
# FORMS_DELIVERY=dry-run
#
# Fix címzett és feladó – a kérésből soha nem írható felül. Teszteléshez kizárólag
# jóváhagyott tesztpostafiók adható meg.
# FORMS_RECIPIENT=
# FORMS_FROM=
# További engedélyezett Origin(ok) vesszővel (pl. az éles domain); a saját origin mindig engedélyezett.
# FORMS_ALLOWED_ORIGINS=
# A rate limit IP-kivonatának sója (véletlen karakterlánc)
# FORMS_RATE_SALT=
# SMTP (TLS kötelező)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
